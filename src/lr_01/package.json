{
  "name": "triangle",
  "version": "0.1.0",
  "description": "triangle kind testing",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "config": {
    "host": "127.0.0.1",
    "port": "8081"
  },
  "scripts": {
    "serve": "npx live-server",
    "serve:test": "npx live-server -q --no-browser --host=%npm_package_config_host% --port=%npm_package_config_port%",
    "start": "npm run serve",
    "test": "concurrently \"npm run serve:test\" \"jest --verbose --coverage ./test/\"",
    "test:e2e": "concurrently \"npm run serve:test\" \"jest --verbose --coverage ./test/selenium.test.js\"",
    "test:unit": "jest --verbose --coverage ./test/jest.test.js"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx)?$": "babel-jest"
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "./test/reports",
          "outputName": "results.xml"
        }
      ],
      [
        "./node_modules/jest-html-reporter",
        {
          "pageTitle": "Test Report",
          "outputPath": "./test/reports/results.html"
        }
      ]
    ],
    "testMatch": [
      "**/test/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/study-pm/testing.git"
  },
  "keywords": [
    "triangle"
  ],
  "author": "viktor",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/study-pm/testing/issues"
  },
  "homepage": "https://gitlab.com/study-pm/testing#readme",
  "dependencies": {
    "live-server": "^1.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.1.0",
    "jest-junit": "^16.0.0",
    "selenium-webdriver": "^4.29.0"
  }
}
